# raonChat 환경 설정
# 이 파일을 복사하여 .env로 저장하고 실제 값을 입력하세요
# cp .env.example .env

# ===========================================
# Gemini API 설정 (필수)
# ===========================================
# https://aistudio.google.com/app/apikey 에서 API 키 생성
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=1024

# ===========================================
# 임베딩 모델 설정 (Gemini API)
# ===========================================
EMBEDDING_MODEL=models/text-embedding-004

# ===========================================
# RAG 설정
# ===========================================
RETRIEVER_K=3

# ===========================================
# 리랭킹(Reranking) 설정
# ===========================================
# 리랭킹 활성화 여부 (true/false)
RERANKER_ENABLED=true

# 리랭커 모델 (다국어 지원, 한국어 포함)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# 초기 벡터 검색 개수 (리랭킹 전)
RETRIEVAL_K=20

# 리랭킹 후 최종 선택 개수
RERANK_TOP_K=3

# 리랭커 최대 시퀀스 길이
RERANKER_MAX_LENGTH=512

# 리랭커 실행 장치 (cpu/cuda/mps)
RERANKER_DEVICE=cpu
