# raonChat 환경 설정
# 이 파일을 복사하여 .env로 저장하고 실제 값을 입력하세요
# cp .env.example .env

# ===========================================
# Gemini API 설정 (필수)
# ===========================================
# https://aistudio.google.com/app/apikey 에서 API 키 생성
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=1024

# ===========================================
# 임베딩 모델 설정 (Gemini API)
# ===========================================
EMBEDDING_MODEL=models/gemini-embedding-001

# ===========================================
# Supabase 설정 (필수)
# ===========================================
# Supabase 프로젝트 Settings > API 에서 확인
SUPABASE_URL=
SUPABASE_KEY=

# ===========================================
# RAG 설정
# ===========================================
RETRIEVER_K=3
